# ============================================================
# PUMUB Digital Library — Environment Configuration (Groq-ready)
# ============================================================
# ဒီ file ကို project root ထဲ .env လို့ rename လုပ်ပြီး အစစ်တွေ ဖြည့်ထည့်ပါ။
# .env ကို GitHub/Git မှာ ဘယ်သောအခါမျှ commit မလုပ်ပါနဲ့ (.gitignore မှာ ရှိပြီး)
# REAL API KEY များကို chat message / document / screenshot တွေမှာ မထည့်ပါနဲ့။
# ============================================================

# -------------------- Flask --------------------
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development

# -------------------- Local MySQL (XAMPP only) --------------------
# Railway က သူ့ MySQL variable တွေကို ကိုယ့်ဘာသာ inject လုပ်ပေးပါတယ်
# (MYSQLHOST/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE/MYSQLPORT) — မပြင်နဲ့။
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=digital_library_db
MYSQLPORT=3306
MYSQL_CHARSET=utf8mb4

# -------------------- Multi-provider AI fallback --------------------
# Providers are tried in this order. Missing/failed providers are skipped.
AI_PROVIDER_ORDER=openrouter,openai,groq,gemini,cerebras

# OpenRouter (primary)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_SITE_URL=https://pumublibinfobot.up.railway.app
OPENROUTER_SITE_NAME=PUMUB LibInfoBot

# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Groq
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_INPUT_CHARS=12000
OPENAI_MAX_OUTPUT_TOKENS=1600
# Structured output (json_schema) on Responses API။ Groq support လုပ်ပြီး;
# provider တစ်ခုက "text" field ကို ပင်ဆာရင် "false" ထားပါ။
OPENAI_USE_STRUCTURED_OUTPUT=true

# Gemini (fallback)
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# Cerebras (last fallback)
CEREBRAS_API_KEY=
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# Legacy selector retained for older code paths; AI_PROVIDER_ORDER controls the new chain.
AI_PROVIDER=primary

# -------------------- AI safety --------------------
AI_MAX_QUESTION_CHARS=2000
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_HEALTHCHECK_ENABLED=false
AI_HEALTHCHECK_TOKEN=

# -------------------- Library file storage --------------------
# Local Windows dev:
LIBRARY_STORAGE_ROOT=D:\PU-MAUBIN\LIBRARY_STORAGE
# Railway production: Railway Volume attach လုပ်ပြီး mount path ထည့်
# LIBRARY_STORAGE_ROOT=/data
# (Volume မရှိရင် upload တင်တဲ့ စာအုပ်/cover တွေ redeploy တိုင်း ပျက်မယ်)

# -------------------- Cloudflare R2 (optional production file storage) --------------------
# Keep the bucket private. Use bucket-scoped Object Read & Write credentials.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET_NAME=pumub-library-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# If omitted, config.py derives this from R2_ACCOUNT_ID.
R2_ENDPOINT=

# -------------------- PDF AI limits --------------------
PDF_MAX_EXTRACT_BYTES=52428800
PDF_MAX_EXTRACT_PAGES=100
PDF_MAX_TEXT_CHARS=500000
PDF_CHUNK_CHARS=1800
PDF_CHUNK_OVERLAP=200
PDF_SUMMARY_MAX_CHUNKS=24
PDF_QA_TOP_K=6

# -------------------- Upload limits --------------------
MAX_CONTENT_LENGTH=52428800
