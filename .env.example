# Copy this file to .env and set the real key locally.
# Never commit .env or expose its values to browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_INPUT_CHARS=12000
OPENAI_MAX_OUTPUT_TOKENS=1600
AI_MAX_QUESTION_CHARS=2000
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_HEALTHCHECK_ENABLED=false
# In production, set a private token and send it only in X-AI-Health-Token for internal checks.
AI_HEALTHCHECK_TOKEN=
FLASK_ENV=production

# PDF AI foundation limits (no PDF Q&A is enabled in this phase)
PDF_MAX_EXTRACT_BYTES=52428800
PDF_MAX_EXTRACT_PAGES=100
PDF_MAX_TEXT_CHARS=500000
PDF_CHUNK_CHARS=1800
PDF_CHUNK_OVERLAP=200
PDF_SUMMARY_MAX_CHUNKS=24
PDF_QA_TOP_K=6

# Existing application settings
SECRET_KEY=replace-with-a-random-secret
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=digital_library_db
MYSQL_PORT=3306
MAX_CONTENT_LENGTH=52428800
