+{% extends "admin/base_admin.html" %}
+{% block title %}Fine Management{% endblock %}
+{% block admin_content %}
+<h4 class="mb-3"><i class="bi bi-cash"></i> Fine Management</h4>
+<div class="row g-3 mb-4">
+  {% for label, key, color in [('Today Generated','today_generated','text-warning'),('This Month Generated','month_generated','text-primary'),('This Month Paid','month_paid','text-success'),('Unpaid Outstanding','unpaid_total','text-danger'),('All-Time Generated','all_time_total','text-dark')] %}
+  <div class="col-md col-6"><div class="card border-0 shadow-sm p-3 h-100"><div class="small text-muted">{{ label }}</div><div class="h5 mb-0 {{ color }}">{{ "{:,.0f}".format(fine_summary[key]) }} MMK</div></div></div>
